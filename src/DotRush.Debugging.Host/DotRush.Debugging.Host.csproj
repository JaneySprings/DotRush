<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Common.Build.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>devhost</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputPath>$(AssetsPath)DevHost</OutputPath>
    <PublishDir>$(OutputPath)</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotRush.Common\DotRush.Common.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.TestPlatform.TranslationLayer" />
    <PackageReference Include="Microsoft.TestPlatform.TestHost" />
    <PackageReference Include="Microsoft.TemplateEngine.IDE" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Installers\DotNetSdkInstaller.bat" CopyToOutputDirectory="PreserveNewest" Link="DotNetSdkInstaller.bat" />
    <None Update="Installers\DotNetSdkInstaller.ps1" CopyToOutputDirectory="PreserveNewest" Link="DotNetSdkInstaller.ps1" />
    <None Update="Installers\DotNetSdkInstaller.sh" CopyToOutputDirectory="PreserveNewest" Link="DotNetSdkInstaller.sh" />
  </ItemGroup>
</Project>
