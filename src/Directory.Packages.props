<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CodeAnalysisVersion>5.9.0</CodeAnalysisVersion>
    <TestPlatformVersion>18.9.0</TestPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="NLog" Version="6.2.0" />
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.0.0.9375" />
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Shared.VSCodeDebugProtocol" Version="18.0.10427.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(TestPlatformVersion)" />
    <PackageVersion Include="Microsoft.TestPlatform.TestHost" Version="$(TestPlatformVersion)" />
    <PackageVersion Include="Microsoft.TestPlatform.TranslationLayer" Version="$(TestPlatformVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="$(CodeAnalysisVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(CodeAnalysisVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(CodeAnalysisVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(CodeAnalysisVersion)" />
    <PackageVersion Include="Microsoft.TemplateEngine.IDE" Version="10.0.400" />
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />

    <!-- Wait for Coreclr -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.4" />
    <PackageVersion Include="Mono.Options" Version="6.12.0.148" />
  </ItemGroup>
</Project>